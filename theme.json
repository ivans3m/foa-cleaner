{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page (No Title / Full Canvas)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-yearly-archive",
			"title": "Yearly Archive",
			"postTypes": [
				"page"
			]
		}
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#FFFFFF"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#F7F6F2"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#0F0E0C"
				},
				{
					"slug": "contrast-secondary",
					"name": "Secondary Text",
					"color": "#6B6760"
				},
				{
					"slug": "contrast-muted",
					"name": "Muted Text",
					"color": "#A8A49F"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#E8E6E1"
				},
				{
					"slug": "border-strong",
					"name": "Border Strong",
					"color": "#D7D4CD"
				},
				{
					"slug": "surface-dark-text",
					"name": "Light on Dark",
					"color": "#F6F4EE"
				},
				{
					"slug": "foa-blue",
					"name": "FoA Blue",
					"color": "#2E70FF"
				},
				{
					"slug": "foa-blue-hover",
					"name": "FoA Blue Hover",
					"color": "#1D5CE6"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"slug": "xs",
					"name": "XS (8px)",
					"size": "0.5rem"
				},
				{
					"slug": "sm",
					"name": "S (16px)",
					"size": "1rem"
				},
				{
					"slug": "md",
					"name": "M (24px)",
					"size": "1.5rem"
				},
				{
					"slug": "lg",
					"name": "L (32px)",
					"size": "2rem"
				},
				{
					"slug": "xl",
					"name": "XL (48px)",
					"size": "3rem"
				},
				{
					"slug": "2-xl",
					"name": "2XL (64px)",
					"size": "clamp(3rem, 5vw, 4rem)"
				},
				{
					"slug": "3-xl",
					"name": "3XL (96px)",
					"size": "clamp(4rem, 7vw, 6rem)"
				},
				{
					"slug": "4-xl",
					"name": "4XL (128px)",
					"size": "clamp(4.5rem, 9vw, 8rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Geist (Display)",
					"fontFamily": "\"Geist\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Geist",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/webfonts/geist-latin-wght-normal.woff2"
							]
						},
						{
							"fontFamily": "Geist",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/webfonts/geist-latin-wght-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "DM Sans (Body)",
					"fontFamily": "\"DM Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/webfonts/dm-sans-latin-wght-normal.woff2"
							]
						},
						{
							"fontFamily": "DM Sans",
							"fontStyle": "italic",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/webfonts/dm-sans-latin-wght-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Geist Mono",
					"fontFamily": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "Geist Mono",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/webfonts/geist-mono-latin-wght-normal.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "XS",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "sm",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "lg",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "xl",
					"name": "XL",
					"size": "1.625rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.625rem"
					}
				},
				{
					"slug": "2-xl",
					"name": "2XL",
					"size": "2.75rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.75rem"
					}
				},
				{
					"slug": "3-xl",
					"name": "3XL",
					"size": "4.5rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4.5rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "6.5rem",
					"fluid": {
						"min": "3rem",
						"max": "6.5rem"
					}
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "subtle",
					"name": "Subtle",
					"shadow": "0 1px 3px rgba(0, 0, 0, 0.05), 0 1px 2px rgba(0, 0, 0, 0.04)"
				},
				{
					"slug": "lift",
					"name": "Lift",
					"shadow": "0 6px 20px rgba(0, 0, 0, 0.08)"
				},
				{
					"slug": "elevated",
					"name": "Elevated",
					"shadow": "0 8px 30px rgba(0, 0, 0, 0.09)"
				}
			]
		},
		"custom": {
			"radius": {
				"sm": "6px",
				"control": "8px",
				"card": "12px",
				"lg": "16px",
				"pill": "9999px"
			},
			"lineHeight": {
				"display": "0.95",
				"tight": "1.1",
				"snug": "1.25",
				"normal": "1.5",
				"body": "1.65"
			},
			"letterSpacing": {
				"display": "-0.045em",
				"tight": "-0.025em",
				"snug": "-0.015em",
				"overline": "0.1em"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|md",
			"padding": {
				"top": "0px",
				"right": "var:preset|spacing|md",
				"bottom": "0px",
				"left": "var:preset|spacing|md"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|base",
			"fontWeight": "400",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|3-xl",
					"fontWeight": "600",
					"lineHeight": "1.05",
					"letterSpacing": "-0.035em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|2-xl",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.025em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|xl",
					"fontWeight": "600",
					"lineHeight": "1.25",
					"letterSpacing": "-0.015em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|lg",
					"fontWeight": "600",
					"lineHeight": "1.3",
					"letterSpacing": "-0.01em"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|base",
					"fontWeight": "600",
					"lineHeight": "1.35"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|xs",
					"fontWeight": "500",
					"lineHeight": "1.4",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|foa-blue"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|foa-blue-hover"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				"border": {
					"radius": "8px"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.5rem",
						"bottom": "0.75rem",
						"left": "1.5rem"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|sm",
					"fontWeight": "500",
					"lineHeight": "1.2",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--foa-btn-primary-hover, #2A2926)",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|foa-blue",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|contrast-muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|sm",
					"lineHeight": "1.5"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "1.125rem",
					"fontWeight": "600",
					"letterSpacing": "-0.03em",
					"lineHeight": "1.2"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|contrast"
							}
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|sm",
					"fontWeight": "500",
					"lineHeight": "1.4"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast-secondary"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|contrast"
							}
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "600",
					"letterSpacing": "-0.025em",
					"lineHeight": "1.12"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|foa-blue"
							}
						}
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|contrast-muted"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|xs",
					"letterSpacing": "0.02em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast-muted"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|contrast"
							}
						}
					}
				}
			},
			"core/post-terms": {
				"color": {
					"text": "var:preset|color|contrast-secondary"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|xs",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast-secondary"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|foa-blue"
							}
						}
					}
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|border-strong",
						"style": "solid",
						"width": "2px"
					}
				},
				"color": {
					"text": "var:preset|color|contrast-secondary"
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|md"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|lg",
					"lineHeight": "1.5"
				}
			},
			"core/pullquote": {
				"border": {
					"top": {
						"color": "var:preset|color|border",
						"style": "solid",
						"width": "1px"
					},
					"bottom": {
						"color": "var:preset|color|border",
						"style": "solid",
						"width": "1px"
					}
				},
				"color": {
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|xl",
						"bottom": "var:preset|spacing|xl"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|2-xl",
					"fontWeight": "600",
					"letterSpacing": "-0.025em",
					"lineHeight": "1.2"
				}
			},
			"core/code": {
				"border": {
					"color": "var:preset|color|border",
					"radius": "8px",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"top": "1.25rem",
						"right": "1.5rem",
						"bottom": "1.25rem",
						"left": "1.5rem"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|sm",
					"lineHeight": "1.65"
				}
			},
			"core/preformatted": {
				"border": {
					"color": "var:preset|color|border",
					"radius": "8px",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"top": "1.25rem",
						"right": "1.5rem",
						"bottom": "1.25rem",
						"left": "1.5rem"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|sm",
					"lineHeight": "1.65"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|border"
				}
			},
			"core/details": {
				"border": {
					"bottom": {
						"color": "var:preset|color|border",
						"style": "solid",
						"width": "1px"
					}
				},
				"spacing": {
					"padding": {
						"top": "1.25rem",
						"bottom": "1.25rem"
					}
				}
			},
			"core/search": {
				"typography": {
					"fontSize": "var:preset|font-size|sm"
				}
			},
			"core/image": {
				"border": {
					"radius": "12px"
				}
			}
		}
	}
}
